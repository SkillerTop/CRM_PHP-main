{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CRM: build backend",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}/backend-node" },
      "problemMatcher": "$tsc"
    },
    {
      "label": "CRM: migrate database",
      "type": "process",
      "command": "node",
      "args": ["--env-file=../backend/.env", "dist/cli.js", "migrate"],
      "options": { "cwd": "${workspaceFolder}/backend-node" },
      "dependsOn": "CRM: build backend",
      "problemMatcher": []
    },
    {
      "label": "CRM: frontend (Vite)",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
