# Copy to backend/.env, replace every placeholder, keep permissions at 0600.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://crm.example.com
APP_TIMEZONE=Europe/Kyiv

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_client_data
DB_USERNAME=crm_app
DB_PASSWORD=replace-me

SESSION_COOKIE=__Host-crm_session
SESSION_SECURE=true
SESSION_SAMESITE=Lax
SESSION_IDLE_HOURS=12

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15

# Must match frontend CRM_PROXY_SHARED_SECRET; generate at least 32 random bytes.
PROXY_SHARED_SECRET=replace-me
TRUSTED_PROXIES=

MAIL_TRANSPORT=smtp
MAIL_FROM_ADDRESS=crm@example.com
MAIL_FROM_NAME=Client Data CRM
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=crm@example.com
SMTP_PASSWORD=replace-me

SYSTEM_NOTIFICATION_EMAIL=admin@example.com
NOTIFY_NEW_REGISTRATIONS=true
REGISTRATION_ALLOWED_DOMAINS=example.com

UPLOAD_DIR=storage/uploads
UPLOAD_MAX_BYTES=20971520
UPLOAD_STORAGE_MAX_BYTES=10737418240
UPLOAD_MAX_REQUESTS_PER_HOUR=100

OCR_TESSERACT_BIN=tesseract
OCR_LANGUAGES=eng+ukr+rus
OCR_MAX_FILE_MB=8
OCR_TIMEOUT_SECONDS=45
OCR_MAX_REQUESTS_PER_HOUR=20

WHISPER_BIN=whisper
WHISPER_MODEL=base
WHISPER_MODEL_DIR=.runtime/whisper-models
WHISPER_LANGUAGE=auto
WHISPER_MAX_FILE_MB=25
WHISPER_TIMEOUT_SECONDS=180
WHISPER_MAX_REQUESTS_PER_HOUR=10
AI_MAX_TIMEOUT_SECONDS=300
AI_MAX_OUTPUT_BYTES=1048576

# Used only by: php backend/bin/console create-admin. Remove after bootstrap.
ADMIN_NAME=CRM Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
