APP_ENV=production
APP_DEBUG=false
APP_URL=https://crm.example.com
APP_TIMEZONE=Europe/Kyiv
TRUSTED_PROXIES=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=client_data_crm
DB_USERNAME=crm_user
DB_PASSWORD=change-me

ADMIN_NAME=CRM Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

SESSION_COOKIE=crm_session
SESSION_SECURE=true
SESSION_SAMESITE=Lax
SESSION_IDLE_HOURS=12
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=8
LOGIN_BLOCK_MINUTES=30

MAIL_TRANSPORT=smtp
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Client Data CRM
SYSTEM_NOTIFICATION_EMAIL=
NOTIFY_NEW_REGISTRATIONS=false
REGISTRATION_ALLOWED_DOMAINS=

UPLOAD_DIR=storage/uploads
UPLOAD_MAX_BYTES=20971520
OCR_TESSERACT_BIN=tesseract
OCR_LANGUAGES=eng+ukr+rus
OCR_TIMEOUT_SECONDS=20
OCR_MAX_FILE_MB=8
WHISPER_BIN=
WHISPER_MODEL=base
WHISPER_MODEL_DIR=
WHISPER_LANGUAGE=
WHISPER_TIMEOUT_SECONDS=60
WHISPER_MAX_FILE_MB=25

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=
SMTP_PASSWORD=

FTP_HOST=vs584.mirohost.net
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
FTP_REMOTE_PATH=/
