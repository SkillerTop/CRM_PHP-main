# Copy to backend/.env for local development in VS Code.
APP_ENV=development
APP_DEBUG=false
APP_URL=http://127.0.0.1:5173
APP_TIMEZONE=Europe/Kyiv
PORT=8080

# Local MySQL 8 server and an empty database created for this project.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_client_data
DB_USERNAME=crm
DB_PASSWORD=replace-with-local-database-password

SESSION_COOKIE=crm_session
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_IDLE_HOURS=12

# Local development does not send mail. Configure SMTP to test email delivery.
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=crm@example.com
MAIL_FROM_NAME=Client Data CRM

UPLOAD_DIR=storage/uploads
UPLOAD_MAX_BYTES=20971520
