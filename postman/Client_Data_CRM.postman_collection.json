{
  "info": {
    "_postman_id": "1e75911c-3dc0-4fc5-a0e9-39f5a13037b3",
    "name": "Client Data CRM API",
    "description": "PHP 8.3/MySQL backend. Postman сохраняет session cookie автоматически. Выполняйте Login, затем Lookup bootstrap, затем CRUD по порядку.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "json", "value": "application/json"}
  ],
  "item": [
    {
      "name": "00 Health and Auth",
      "item": [
        {
          "name": "Health",
          "request": {"method": "GET", "url": "{{base_url}}/health"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('API and DB are healthy', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.status).to.eql('ok'); });"]}}]
        },
        {
          "name": "Register (role injection is ignored)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"full_name\": \"Postman Readonly\",\n  \"email\": \"postman.readonly@example.com\",\n  \"password\": \"Postman123!\",\n  \"password_confirmation\": \"Postman123!\",\n  \"role\": \"admin\"\n}"},
            "url": "{{base_url}}/auth/register"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Registration accepted without trusting role', function () { pm.expect([201, 202]).to.include(pm.response.code); });"]}}]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"},
            "url": "{{base_url}}/auth/login"
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Login successful', function () { pm.response.to.have.status(200); });",
            "const json = pm.response.json();",
            "pm.environment.set('csrf_token', json.data.csrf_token);",
            "pm.expect(json.data.user.role).to.eql('admin');"
          ]}}]
        },
        {
          "name": "Current User",
          "request": {"method": "GET", "url": "{{base_url}}/auth/me"},
          "event": [{"listen": "test", "script": {"exec": ["const json = pm.response.json(); pm.response.to.have.status(200); pm.environment.set('csrf_token', json.data.csrf_token);"]}}]
        },
        {
          "name": "Forgot Password (generic response)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\":\"nobody@example.invalid\"}"},
            "url": "{{base_url}}/auth/forgot-password"
          }
        }
      ]
    },
    {
      "name": "01 Lookups Bootstrap",
      "item": [
        {
          "name": "Get all active lookups and store IDs",
          "request": {"method": "GET", "url": "{{base_url}}/lookups"},
          "event": [{"listen": "test", "script": {"exec": [
            "pm.response.to.have.status(200);",
            "const d = pm.response.json().data;",
            "const byKey = (type, key) => d[type].find(x => x.key === key).id;",
            "pm.environment.set('company_type_id', byKey('company_type', 'shipyard'));",
            "pm.environment.set('client_status_id', byKey('client_status', 'new_lead'));",
            "pm.environment.set('contact_source_id', byKey('contact_source', 'exhibition'));",
            "pm.environment.set('manager_id', byKey('cjn_manager', 'vitalii_vyshnevskyi'));",
            "pm.environment.set('task_status_id', byKey('task_status', 'not_started'));",
            "pm.environment.set('outcome_status_id', byKey('outcome_status', 'neutral'));",
            "pm.environment.set('reminder_lead_id', byKey('reminder_lead_time', 'one_day'));"
          ]}}]
        }
      ]
    },
    {
      "name": "02 Companies",
      "item": [
        {
          "name": "Create Company",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Postman Marine {{$timestamp}}\",\n  \"type_id\": {{company_type_id}},\n  \"country\": \"Україна\",\n  \"city\": \"Київ\",\n  \"status_id\": {{client_status_id}},\n  \"website\": \"example.com\",\n  \"linkedin\": \"https://linkedin.com/company/example\",\n  \"description\": \"Тест кирилиці, Höflich, €\"\n}"},
            "url": "{{base_url}}/companies"
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.response.to.have.status(201); const d = pm.response.json().data;",
            "pm.environment.set('company_id', d.id); pm.environment.set('company_name', d.name); pm.environment.set('company_updated_at', d.updated_at);",
            "pm.expect(d.website).to.match(/^https:\\/\\//);"
          ]}}]
        },
        {
          "name": "List Companies (filters/sort/page)",
          "request": {"method": "GET", "url": "{{base_url}}/companies?status={{client_status_id}}&q=Postman&page=1&sort=name&dir=asc"}
        },
        {
          "name": "Get Company",
          "request": {"method": "GET", "url": "{{base_url}}/companies/{{company_id}}"},
          "event": [{"listen": "test", "script": {"exec": ["const d = pm.response.json().data; pm.environment.set('company_updated_at', d.updated_at);"]}}]
        },
        {
          "name": "Update Company with optimistic lock",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"{{company_name}} Updated\",\n  \"type_id\": {{company_type_id}},\n  \"country\": \"Україна\",\n  \"city\": \"Одеса\",\n  \"status_id\": {{client_status_id}},\n  \"website\": \"example.com\",\n  \"description\": \"Updated through Postman\",\n  \"updated_at\": \"{{company_updated_at}}\"\n}"},
            "url": "{{base_url}}/companies/{{company_id}}"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(200); pm.environment.set('company_updated_at', pm.response.json().data.updated_at);"]}}]
        }
      ]
    },
    {
      "name": "03 Contacts",
      "item": [
        {
          "name": "Create Contact with conditional source detail",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"company_id\": {{company_id}},\n  \"first_name\": \"Іван\",\n  \"last_name\": \"Тестовий\",\n  \"position\": \"CTO\",\n  \"phone\": \"+380 (44) 123-45-67\",\n  \"email\": \"postman.contact.{{$timestamp}}@example.com\",\n  \"source_id\": {{contact_source_id}},\n  \"source_detail\": \"SMM Hamburg\",\n  \"initiated_by_id\": {{manager_id}}\n}"},
            "url": "{{base_url}}/contacts"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(201); const d=pm.response.json().data; pm.environment.set('contact_id', d.id); pm.environment.set('contact_email', d.email); pm.environment.set('contact_updated_at', d.updated_at);"]}}]
        },
        {
          "name": "List Contacts",
          "request": {"method": "GET", "url": "{{base_url}}/contacts?company={{company_id}}&has_linkedin=any&q=Іван&page=1"}
        },
        {
          "name": "Update Contact",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"company_id\": {{company_id}},\n  \"first_name\": \"Іван\",\n  \"last_name\": \"Тестовий\",\n  \"position\": \"Technical Director\",\n  \"email\": \"{{contact_email}}\",\n  \"source_id\": {{contact_source_id}},\n  \"source_detail\": \"SMM Hamburg 2026\",\n  \"initiated_by_id\": {{manager_id}},\n  \"updated_at\": \"{{contact_updated_at}}\"\n}"},
            "url": "{{base_url}}/contacts/{{contact_id}}"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(200); pm.environment.set('contact_updated_at', pm.response.json().data.updated_at);"]}}]
        }
      ]
    },
    {
      "name": "04 Tasks, Comments and Files",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"company_id\": {{company_id}},\n  \"name\": \"Postman follow-up\",\n  \"contact_date\": \"2026-08-06\",\n  \"manager_id\": {{manager_id}},\n  \"contact_person_id\": {{contact_id}},\n  \"description\": \"Обсудить предложение\",\n  \"status_id\": {{task_status_id}},\n  \"outcome_status_id\": {{outcome_status_id}},\n  \"outcome_notes\": \"Ожидаем ответ\",\n  \"deadline\": \"2027-08-06T17:00:00+03:00\",\n  \"reminder_lead_ids\": [{{reminder_lead_id}}]\n}"},
            "url": "{{base_url}}/tasks"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(201); const d=pm.response.json().data; pm.environment.set('task_id', d.id); pm.environment.set('task_updated_at', d.updated_at);"]}}]
        },
        {
          "name": "List Actual Tasks",
          "request": {"method": "GET", "url": "{{base_url}}/tasks?manager={{manager_id}}&state=actual&page=1&sort=contact_date&dir=desc"}
        },
        {
          "name": "Update Task including Contact Date",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"company_id\": {{company_id}},\n  \"name\": \"Postman follow-up updated\",\n  \"contact_date\": \"2026-08-07\",\n  \"manager_id\": {{manager_id}},\n  \"contact_person_id\": {{contact_id}},\n  \"description\": \"Description is logged\",\n  \"status_id\": {{task_status_id}},\n  \"outcome_status_id\": {{outcome_status_id}},\n  \"outcome_notes\": \"Outcome notes are logged\",\n  \"deadline\": \"2027-08-07T17:00:00+03:00\",\n  \"reminder_lead_ids\": [{{reminder_lead_id}}],\n  \"updated_at\": \"{{task_updated_at}}\"\n}"},
            "url": "{{base_url}}/tasks/{{task_id}}"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(200); pm.environment.set('task_updated_at', pm.response.json().data.updated_at);"]}}]
        },
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\"text\":\"Комментарий из Postman\"}"},
            "url": "{{base_url}}/tasks/{{task_id}}/comments"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(201); pm.environment.set('comment_id', pm.response.json().data.id);"]}}]
        },
        {
          "name": "Hide Comment (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\"hidden\":true}"},
            "url": "{{base_url}}/tasks/{{task_id}}/comments/{{comment_id}}"
          }
        },
        {
          "name": "Task Change Log",
          "request": {"method": "GET", "url": "{{base_url}}/tasks/{{task_id}}/log"},
          "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(200); const fields=pm.response.json().data.map(x=>x.field_name); pm.expect(fields).to.include('Contact Date'); pm.expect(fields).to.include('Description'); pm.expect(fields).to.include('Outcome notes');"]}}]
        },
        {
          "name": "Download reminder.ics",
          "request": {"method": "GET", "url": "{{base_url}}/tasks/{{task_id}}/reminder.ics"}
        },
        {
          "name": "Upload Attachment",
          "request": {
            "method": "POST",
            "header": [{"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "formdata", "formdata": [{"key": "file", "type": "file", "src": []}]},
            "url": "{{base_url}}/tasks/{{task_id}}/attachments",
            "description": "Перед запуском вручную выберите PDF/DOC/XLS/изображение до 20 МБ."
          }
        }
      ]
    },
    {
      "name": "05 Dashboard and Search",
      "item": [
        {"name": "Dashboard", "request": {"method": "GET", "url": "{{base_url}}/dashboard"}},
        {"name": "Pipeline", "request": {"method": "GET", "url": "{{base_url}}/pipeline"}},
        {"name": "Global Search Cyrillic", "request": {"method": "GET", "url": "{{base_url}}/search?q=Обсудить"}}
      ]
    },
    {
      "name": "06 Admin",
      "item": [
        {
          "name": "Create User with Temporary Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"full_name\": \"Postman Editor\",\n  \"email\": \"postman.editor.{{$timestamp}}@example.com\",\n  \"role\": \"editor\",\n  \"is_active\": true,\n  \"delivery\": \"temporary_password\",\n  \"temporary_password\": \"Temporary123!\"\n}"},
            "url": "{{base_url}}/users"
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.response.to.have.status(201); const d=pm.response.json().data; pm.environment.set('user_id', d.id); pm.environment.set('user_updated_at', d.updated_at);"]}}]
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"full_name\": \"Postman Manager\",\n  \"role\": \"manager\",\n  \"is_active\": true,\n  \"updated_at\": \"{{user_updated_at}}\"\n}"},
            "url": "{{base_url}}/users/{{user_id}}"
          }
        },
        {"name": "Users and pending registrations", "request": {"method": "GET", "url": "{{base_url}}/users"}},
        {"name": "Audit JSON", "request": {"method": "GET", "url": "{{base_url}}/audit?action=FIELD%20CHANGE&entity_type=Task&page=1"}},
        {"name": "Audit CSV", "request": {"method": "GET", "url": "{{base_url}}/audit?format=csv"}}
      ]
    },
    {
      "name": "99 Cleanup (manual order)",
      "item": [
        {
          "name": "Archive Task",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\"archived\":true,\"updated_at\":\"{{task_updated_at}}\"}"},
            "url": "{{base_url}}/tasks/{{task_id}}/archive"
          }
        },
        {
          "name": "Archive Contact",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\"archived\":true,\"updated_at\":\"{{contact_updated_at}}\"}"},
            "url": "{{base_url}}/contacts/{{contact_id}}/archive"
          }
        },
        {
          "name": "Archive Company",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}],
            "body": {"mode": "raw", "raw": "{\"archived\":true,\"updated_at\":\"{{company_updated_at}}\"}"},
            "url": "{{base_url}}/companies/{{company_id}}/archive"
          }
        },
        {
          "name": "Logout",
          "request": {"method": "POST", "header": [{"key": "X-CSRF-Token", "value": "{{csrf_token}}"}], "url": "{{base_url}}/auth/logout"}
        }
      ]
    }
  ]
}
