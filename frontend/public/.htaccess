Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # backend/public is the document root. Keep API requests on the original
    # URI while executing the PHP front controller next to this file.
    RewriteRule ^api(?:/.*)?$ index.php [QSA,L]

    # Serve generated assets and other existing public files as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Missing versioned assets must be a real 404, not the SPA shell.
    RewriteRule ^assets(?:/.*)?$ - [R=404,L]

    # React handles every other application route, including reset-password.
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
    AddType text/plain .aff .dic
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; form-action 'self'"

    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(?:aff|css|dic|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
