<VirtualHost *:80>
    ServerName crm.example.com
    Redirect permanent / https://crm.example.com/
</VirtualHost>

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName crm.example.com
    DocumentRoot /var/www/client-data-crm/backend/public

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/crm.example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/crm.example.com/privkey.pem
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    <Directory /var/www/client-data-crm/backend/public>
        AllowOverride All
        Options -Indexes +FollowSymLinks
        Require all granted
    </Directory>

    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php8.3-fpm.sock|fcgi://localhost/"
    </FilesMatch>

    <Directory /var/www/client-data-crm>
        Require all denied
    </Directory>
    <Directory /var/www/client-data-crm/backend/public>
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/client-data-crm-error.log
    CustomLog ${APACHE_LOG_DIR}/client-data-crm-access.log combined
</VirtualHost>
</IfModule>

