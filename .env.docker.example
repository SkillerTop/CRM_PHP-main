# Copy to .env.docker (never commit it) and replace every "replace-…" value.
# Used both as Compose variables (--env-file .env.docker) and as the app's environment.

# --- Docker -----------------------------------------------------------------
# Image tag built by `docker compose build` and used by app + scheduler.
CRM_IMAGE=client-data-crm:latest
# Host address/port of the app container. Keep 127.0.0.1 behind a reverse proxy.
CRM_BIND=127.0.0.1
CRM_PORT=8080
# Directory on the host with faster-whisper-large-v3-turbo/ and paddleocr/official_models/.
CRM_MODELS_DIR=./.runtime/models
# Public domain for the built-in HTTPS proxy (--profile https).
CRM_DOMAIN=crm.example.com
# Apply database migrations when the app container starts.
RUN_MIGRATIONS=true

# --- Application --------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=https://crm.example.com
APP_TIMEZONE=Europe/Kyiv

# --- Database -----------------------------------------------------------------
# DB_HOST=db uses the bundled MySQL (--profile local-db); otherwise your server's host.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=replace-with-unique-database-password
# Only for --profile local-db (first start of the MySQL volume).
MYSQL_ROOT_PASSWORD=replace-with-unique-root-password

# --- Sessions and proxy -------------------------------------------------------
SESSION_COOKIE=crm_session
SESSION_SECURE=true
SESSION_SAMESITE=Lax
SESSION_IDLE_HOURS=12
# At least 32 random bytes, e.g. `openssl rand -hex 32`. The HTTPS proxy sends it so
# the app can trust X-Forwarded-For (real client IPs for login limits and audit).
PROXY_SHARED_SECRET=replace-with-random-secret-at-least-32-characters
# Comma-separated proxy IPs for a proxy that cannot send the secret (optional).
TRUSTED_PROXIES=

# --- Mail (production requires smtp or mail) ----------------------------------
MAIL_TRANSPORT=smtp
MAIL_FROM_ADDRESS=crm@example.com
MAIL_FROM_NAME=CRM
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=crm@example.com
SMTP_PASSWORD=replace-with-smtp-password
SYSTEM_NOTIFICATION_EMAIL=
NOTIFY_NEW_REGISTRATIONS=true
REGISTRATION_ALLOWED_DOMAINS=

# --- Uploads ------------------------------------------------------------------
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_REQUESTS_PER_HOUR=100

# --- Speech (Faster-Whisper) and OCR (PaddleOCR) -------------------------------
# Paths and devices are set in compose.yaml; WHISPER_DEVICE/OCR_DEVICE can be
# overridden here (cpu / cpu) on a host without an NVIDIA GPU.
WHISPER_LANGUAGE=auto
WHISPER_TIMEOUT_SECONDS=900
WHISPER_MAX_REQUESTS_PER_HOUR=10
OCR_LANGUAGE=uk
OCR_MAX_FILE_MB=20
OCR_TIMEOUT_SECONDS=300
OCR_MAX_REQUESTS_PER_HOUR=20
AI_MAX_TIMEOUT_SECONDS=900

# --- Company details from the company's website ---------------------------------
COMPANY_LOOKUP_ENABLED=true
COMPANY_LOOKUP_MAX_REQUESTS_PER_HOUR=60
COMPANY_LOOKUP_TIMEOUT_SECONDS=20
COMPANY_LOOKUP_REQUEST_TIMEOUT_SECONDS=8
