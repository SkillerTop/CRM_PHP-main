CRM_PORT=8080
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Kyiv
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=replace-with-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-unique-root-password
SESSION_COOKIE=crm_session
SESSION_SECURE=false
SESSION_SAMESITE=Lax
MAIL_TRANSPORT=log
